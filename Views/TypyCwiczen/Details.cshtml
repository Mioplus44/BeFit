@model TypCwiczenia
@{
    ViewData["Title"] = Model.Nazwa;
}
<h1>@Model.Nazwa</h1>
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Opis)</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Opis) ? "Brak opisu" : Model.Opis)</dd>
</dl>
<a class="btn btn-secondary" asp-action="Index">Wróć do listy</a>
@if (User.IsInRole("Administrator"))
{
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edytuj</a>
}
