@model IEnumerable<TypCwiczenia>
@{
    ViewData["Title"] = "Typy ćwiczeń";
    var admin = User.IsInRole("Administrator");
}
<h1>Typy ćwiczeń</h1>

@if (TempData["Blad"] is string blad)
{
    <div class="alert alert-danger">@blad</div>
}
@if (admin)
{
    <p><a class="btn btn-primary" asp-action="Create">Dodaj typ ćwiczenia</a></p>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Nazwa)</th>
            <th>@Html.DisplayNameFor(m => m.Opis)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nazwa</td>
                <td>@item.Opis</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Szczegóły</a>
                    @if (admin)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edytuj</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Usuń</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
