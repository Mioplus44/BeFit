@model WykonaneCwiczenie
@{
    ViewData["Title"] = "Usuwanie ćwiczenia";
}
<h1>Usuwanie wykonanego ćwiczenia</h1>
<div class="alert alert-warning">Czy na pewno chcesz usunąć ten wpis?</div>
<partial name="_Szczegoly" model="Model" />
<form asp-action="Delete" asp-route-id="@Model.Id">
    <button type="submit" class="btn btn-danger">Usuń</button>
    <a class="btn btn-secondary" asp-action="Index">Anuluj</a>
</form>
