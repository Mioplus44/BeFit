@model WykonaneCwiczenie
@{
    ViewData["Title"] = "Edycja ćwiczenia";
}
<h1>Edycja wykonanego ćwiczenia</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" class="col-md-6">
    <partial name="_Form" />
    <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
    <a class="btn btn-secondary" asp-action="Index">Anuluj</a>
</form>
