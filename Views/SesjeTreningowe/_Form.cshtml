@model SesjaTreningowa
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3">
    <label asp-for="Poczatek" class="form-label"></label>
    <input asp-for="Poczatek" type="datetime-local" class="form-control" />
    <div class="form-text">Data i godzina rozpoczęcia treningu.</div>
    <span asp-validation-for="Poczatek" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Koniec" class="form-label"></label>
    <input asp-for="Koniec" type="datetime-local" class="form-control" />
    <div class="form-text">Musi być późniejsza niż początek; sesja może trwać maksymalnie 24 godziny.</div>
    <span asp-validation-for="Koniec" class="text-danger"></span>
</div>
