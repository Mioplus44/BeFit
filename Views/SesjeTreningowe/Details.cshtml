@model SesjaTreningowa
@{
    ViewData["Title"] = "Szczegóły sesji";
}
<h1>Szczegóły sesji treningowej</h1>
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Poczatek)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Poczatek)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Koniec)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Koniec)</dd>
</dl>
<a class="btn btn-secondary" asp-action="Index">Wróć do listy</a>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edytuj</a>
